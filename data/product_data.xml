<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Servicios base para plantillas de cotización.
         Uso product.product para evitar ambigüedad de xml_id al referenciar
         desde sale.order.template.line. -->

    <record id="product_balanceo" model="product.product">
        <field name="name">Balanceo de rueda</field>
        <field name="type">service</field>
        <field name="list_price">3500.0</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="invoice_policy">order</field>
    </record>

    <record id="product_diagnostico_alineacion" model="product.product">
        <field name="name">Diagnóstico de alineación</field>
        <field name="type">service</field>
        <field name="list_price">5000.0</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="invoice_policy">order</field>
    </record>

    <record id="product_alineacion_correctiva" model="product.product">
        <field name="name">Alineación correctiva tren delantero</field>
        <field name="type">service</field>
        <field name="list_price">20000.0</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="invoice_policy">order</field>
    </record>

    <record id="product_valvula" model="product.product">
        <field name="name">Válvula de neumático</field>
        <field name="type">consu</field>
        <field name="list_price">1200.0</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">True</field>
        <field name="invoice_policy">order</field>
    </record>

    <record id="product_eliminacion_cubierta" model="product.product">
        <field name="name">Eliminación de cubierta usada</field>
        <field name="type">service</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="invoice_policy">order</field>
    </record>

    <record id="product_montaje" model="product.product">
        <field name="name">Montaje de cubierta</field>
        <field name="type">service</field>
        <field name="list_price">4000.0</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="invoice_policy">order</field>
    </record>

</odoo>
