<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="equipo_elevador_2col" model="workshop.equipo">
        <field name="name">Elevador 2 columnas</field>
        <field name="tipo">elevador_2col</field>
        <field name="description">Elevador de dos columnas para auto y camioneta liviana hasta 3500 kg.</field>
    </record>

    <record id="equipo_elevador_4col" model="workshop.equipo">
