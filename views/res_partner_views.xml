<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_partner_form_workshop" model="ir.ui.view">
        <field name="name">res.partner.form.workshop</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Taller (Camilleti)" name="workshop">
                    <group>
                        <group string="Contacto flota">
                            <field name="autoriza_ordenes"/>
                            <field name="es_conductor"/>
                        </group>
                        <group string="Turnos">
                            <field name="umbral_no_shows"/>
                            <field name="cantidad_no_shows" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
