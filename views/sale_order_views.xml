<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════ FORM ════════════════════
         UX basado en neurociencia:
         - Header con UN botón primario destacado (Von Restorff / foco único)
         - Banner de ayuda contextual por etapa (reduce carga cognitiva)
         - Progress bar visible (feedback visual de avance)
         - Statusbar clickeable con la secuencia del taller
    -->
    <record id="view_sale_order_form_workshop" model="ir.ui.view">
        <field name="name">sale.order.form.workshop</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Declarar TODOS los campos del taller primero, así las expresiones
                 invisible/readonly de botones y bloques posteriores pueden
                 referenciarlos sin error de validación (Odoo 17+ estricto). -->
            <xpath expr="//header" position="inside">
                <field name="workshop_state" widget="statusbar"
                       statusbar_visible="received,diagnosis,quoted,in_repair,ready,delivered"
                       options="{'clickable': false}"/>
                <field name="customer_approved" invisible="1"/>
                <field name="workshop_progress" invisible="1"/>
                <field name="workshop_color" invisible="1"/>
                <field name="workshop_next_action" invisible="1"/>
                <field name="workshop_helper" invisible="1"/>

                <!-- Botones contextuales del taller -->
                <button name="action_workshop_start_diagnosis"
                        type="object"
                        string="Iniciar Diagnóstico"
                        class="btn-primary o_workshop_cta"
                        invisible="workshop_state != 'received'"
                        groups="camiletti_workshop.group_workshop_reception"/>
                <button name="action_workshop_to_quote"
                        type="object"
                        string="Pasar a Presupuesto"
                        class="btn-primary o_workshop_cta"
                        invisible="workshop_state not in ('received','diagnosis')"
                        groups="camiletti_workshop.group_workshop_reception"/>
                <button name="action_workshop_register_approval"
                        type="object"
                        string="Registrar Aprobación"
                        class="btn-primary o_workshop_cta"
                        invisible="workshop_state != 'quoted' or customer_approved"
                        groups="camiletti_workshop.group_workshop_reception"/>
                <button name="action_workshop_start_repair"
                        type="object"
                        string="Empezar Reparación"
                        class="btn-primary o_workshop_cta"
                        invisible="workshop_state != 'quoted' or not customer_approved"/>
                <button name="action_workshop_mark_ready"
                        type="object"
                        string="Marcar Listo"
                        class="btn-primary o_workshop_cta"
                        invisible="workshop_state != 'in_repair'"
                        groups="camiletti_workshop.group_workshop_technician"/>
                <button name="action_workshop_deliver"
                        type="object"
                        string="Entregar y Facturar"
                        class="btn-primary o_workshop_cta"
                        invisible="workshop_state != 'ready'"
                        groups="camiletti_workshop.group_workshop_reception"/>
                <button name="action_workshop_cancel"
                        type="object"
                        string="Cancelar OT"
                        class="btn-secondary"
                        confirm="Confirmas cancelar esta OT?"
                        invisible="workshop_state in ('delivered','cancelled')"
                        groups="camiletti_workshop.group_workshop_manager"/>
                <button name="action_workshop_reopen"
                        type="object"
                        string="Reabrir"
                        class="btn-secondary"
                        invisible="workshop_state != 'cancelled'"
                        groups="camiletti_workshop.group_workshop_manager"/>
            </xpath>

            <!-- Banner contextual de ayuda (neurociencia: carga cognitiva mínima) -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info o_workshop_helper"
                     role="status"
                     invisible="not workshop_helper">
                    <field name="workshop_helper" nolabel="1" readonly="1"/>
                </div>
            </xpath>

            <!-- Smart button para abrir la Inspección DVI -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_inspection" type="object"
                        class="oe_stat_button" icon="fa-search-plus"
                        invisible="not inspection_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Inspección</span>
                        <span class="o_stat_text">DVI</span>
                    </div>
                </button>
            </xpath>

            <!-- Bloque de datos del vehículo, después del cliente -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="vehicle_id"
                       options="{'no_create': False, 'no_open': False}"
                       domain="[('partner_id','=?', partner_id)]"
                       context="{'default_partner_id': partner_id}"
                       required="workshop_state in ('diagnosis','quoted','in_repair','ready','delivered')"/>
                <field name="license_plate" readonly="1" invisible="not vehicle_id"/>
                <field name="inspection_id" invisible="1"/>
            </xpath>

            <!-- Km y técnico junto a las fechas -->
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="km_in" placeholder="Odómetro al recibir"/>
                <field name="km_out"
                       readonly="workshop_state not in ('ready','delivered')"
                       invisible="workshop_state in ('received','diagnosis','quoted','in_repair')"/>
                <field name="technician_id"
                       options="{'no_create': True}"
                       required="workshop_state in ('diagnosis','in_repair','ready','delivered')"/>
                <field name="bay_id"
                       options="{'no_create': True}"
                       required="workshop_state in ('in_repair','ready')"/>
            </xpath>

            <!-- Campos del taller en líneas: DOT, posición, terminado -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="dot_code" string="DOT" optional="show"/>
                <field name="installed_position" string="Posición" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <field name="workshop_done" string="Hecho"
                       optional="show" widget="boolean_toggle"/>
            </xpath>

            <!-- Pestaña adicional "Taller" con diagnóstico y aprobación -->
            <xpath expr="//notebook" position="inside">
                <page string="Taller" name="workshop"
                      invisible="workshop_state == 'cancelled'">
                    <group>
                        <group string="Diagnóstico">
                            <field name="diagnosis_notes"
                                   nolabel="1"
                                   placeholder="Qué se encontró al revisar el vehículo..."
                                   colspan="2"/>
                        </group>
                        <group string="Aprobación del cliente">
                            <field name="customer_approved"
                                   readonly="workshop_state in ('in_repair','ready','delivered')"/>
                            <field name="approval_note"
                                   placeholder="Ej: OK por WhatsApp 20/04"
                                   readonly="customer_approved and workshop_state in ('in_repair','ready','delivered')"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ════════════════════ KANBAN TALLER ════════════════════ -->
    <record id="view_sale_order_kanban_workshop" model="ir.ui.view">
        <field name="name">sale.order.kanban.workshop</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="workshop_state"
                    class="o_workshop_kanban o_kanban_small_column"
                    records_draggable="1"
                    group_create="0"
                    group_delete="0"
                    group_edit="0"
                    quick_create="0">
                <field name="workshop_state"/>
                <field name="workshop_color"/>
                <field name="workshop_progress"/>
                <field name="license_plate"/>
                <field name="vehicle_id"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="bay_id"/>
                <field name="amount_total"/>
                <field name="customer_approved"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="o_workshop_card o_workshop_card_#{record.workshop_state.raw_value}">
                            <div class="o_workshop_plate">
                                <i class="fa fa-car me-2"/>
                                <strong><field name="license_plate"/></strong>
                            </div>
                            <div class="o_workshop_customer text-muted small">
                                <field name="partner_id"/>
                            </div>
                            <div class="mt-1">
                                <field name="vehicle_id"/>
                            </div>
                            <div class="d-flex justify-content-between mt-2 small">
                                <span t-if="record.technician_id.raw_value">
                                    <i class="fa fa-user-circle me-1"/>
                                    <field name="technician_id"/>
                                </span>
                                <span t-if="record.bay_id.raw_value" class="badge text-bg-secondary">
                                    <i class="fa fa-map-marker me-1"/>
                                    <field name="bay_id"/>
                                </span>
                                <span class="fw-bold">
                                    <field name="amount_total" widget="monetary"/>
                                </span>
                            </div>
                            <div class="progress mt-2" style="height: 4px;">
                                <div class="progress-bar o_workshop_progress_bar"
                                     t-attf-style="width: #{record.workshop_progress.raw_value}%"/>
                            </div>
                            <div t-if="record.workshop_state.raw_value == 'quoted' and !record.customer_approved.raw_value"
                                 class="alert alert-warning p-1 mt-2 mb-0 small">
                                Esperando aprobación
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ════════════════════ SEARCH TALLER ════════════════════ -->
    <record id="view_sale_order_search_workshop" model="ir.ui.view">
        <field name="name">sale.order.search.workshop</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Número OT"/>
                <field name="license_plate" string="Patente"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="technician_id"/>
                <field name="bay_id"/>
                <filter name="in_progress" string="En curso"
                        domain="[('workshop_state','in',['received','diagnosis','quoted','in_repair','ready'])]"/>
                <filter name="waiting_approval" string="Esperando aprobación"
                        domain="[('workshop_state','=','quoted'),('customer_approved','=',False)]"/>
                <filter name="ready_filter" string="Listos para entregar"
                        domain="[('workshop_state','=','ready')]"/>
                <filter name="delivered" string="Entregados"
                        domain="[('workshop_state','=','delivered')]"/>
                <filter name="cancelled" string="Canceladas"
                        domain="[('workshop_state','=','cancelled')]"/>
                <separator/>
                <filter name="my_tech" string="Asignadas a mí"
                        domain="[('technician_id','=',uid)]"/>
                <group>
                    <filter name="group_wstate" string="Estado taller"
                            context="{'group_by': 'workshop_state'}"/>
                    <filter name="group_tech" string="Técnico"
                            context="{'group_by': 'technician_id'}"/>
                    <filter name="group_bay" string="Bahía"
                            context="{'group_by': 'bay_id'}"/>
                    <filter name="group_partner" string="Cliente"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════════ ACTION TALLER ════════════════════ -->
    <record id="action_workshop_orders" model="ir.actions.act_window">
        <field name="name">Órdenes de Taller</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_sale_order_search_workshop"/>
        <field name="context">{
            'search_default_in_progress': 1,
            'default_workshop_state': 'received',
        }</field>
    </record>

    <record id="action_workshop_orders_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_sale_order_kanban_workshop"/>
        <field name="act_window_id" ref="action_workshop_orders"/>
    </record>
</odoo>
