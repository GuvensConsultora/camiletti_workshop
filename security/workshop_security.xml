<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_workshop" model="ir.module.category">
        <field name="name">Taller</field>
        <field name="description">Gestión de taller de neumáticos y tren delantero/trasero</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_workshop_reception" model="res.groups">
        <field name="name">Taller / Recepción</field>
        <field name="category_id" ref="module_category_workshop"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Recepcionistas: crean OT, toman datos del vehículo, emiten presupuestos, registran aprobación y cierre con entrega.</field>
    </record>

    <record id="group_workshop_technician" model="res.groups">
        <field name="name">Taller / Técnico</field>
        <field name="category_id" ref="module_category_workshop"/>
        <field name="comment">Técnicos: ejecutan diagnóstico y reparación, marcan items terminados, avisan listo.</field>
    </record>

    <record id="group_workshop_manager" model="res.groups">
        <field name="name">Taller / Gerente</field>
        <field name="category_id" ref="module_category_workshop"/>
        <field name="implied_ids" eval="[(4, ref('group_workshop_reception')), (4, ref('group_workshop_technician')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="comment">Gerente: todos los permisos + puede anular guards con justificación.</field>
    </record>
</odoo>
